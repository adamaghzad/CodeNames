# ---- Groq AI (required for real AI boards; without it the app runs in labelled demo mode) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# ---- Supabase (optional locally; required for durable/hosted multiplayer) ----
# Browser-safe values: project URL + publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback also accepted (same value as publishable/anon):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # or legacy anon JWT

# Server-only secret: NEVER prefix with NEXT_PUBLIC_ and never expose in the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy fallback also accepted:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt

# ---- Guest identity signing (set in production; falls back to Supabase secret / per-boot random) ----
GUEST_AUTH_SECRET=change-me-to-a-long-random-string
